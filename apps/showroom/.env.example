# Production browser-facing URLs. Rebuild after changing these values.
VITE_API_URL=https://api.tijarago.com
VITE_DASHBOARD_URL=https://dash.tijarago.com
VITE_STOREFRONT_BASE_DOMAIN=tijarago.com
# Optional public, monitored support mailbox; omit to hide the support mail link.
VITE_SUPPORT_EMAIL=
# Local Vite proxy target; never a browser production URL.
VITE_BACKEND_PROXY_TARGET=https://127.0.0.1:8001
